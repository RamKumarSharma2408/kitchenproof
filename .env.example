# KitchenProof Environment Variables
# Copy to .env for local development

# Database URL (SQLite for local zero-cost ACID storage, or PostgreSQL connection string for Supabase/Neon)
DATABASE_URL="file:./dev.db"

# Authentication Session Secret (at least 32 characters in production)
JWT_SECRET="kitchenproof_dev_secret_key_change_in_production_min_32_chars"

# Node Environment
NODE_ENV="development"

# App Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

